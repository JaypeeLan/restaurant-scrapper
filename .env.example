# ── Storage ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
# Database name returned by GET /api/health as `db`.
MONGODB_DB_NAME=restaurants

# ── Source 1: Instagram Graph API (optional — add later) ──────────────────────
# Leave empty to run Playwright-only. When set, Graph becomes primary for
# business/creator handles and Playwright stays the fallback.
IG_GRAPH_ACCESS_TOKEN=
IG_GRAPH_USER_ID=
IG_GRAPH_VERSION=v21.0
IG_GRAPH_CALLS_PER_HOUR=180
IG_GRAPH_MEDIA_LIMIT=25

# ── Source 2: Playwright (primary until Graph credentials are set) ────────────
IG_FALLBACK_ENABLED=true
# THE number that matters. From one residential IP, logged-out Instagram
# tolerates ~100-150 profile fetches/hour before serving interstitials that
# stick to your IP for hours. Keep this low; let the queue drain over days.
IG_FALLBACK_MAX_PER_RUN=40
IG_FALLBACK_MIN_GAP_S=20
IG_FALLBACK_MAX_GAP_S=55
# Optional. Empty = your own IP. Datacenter IPs (e.g. Render) need a residential proxy.
IG_PROXY_URL=
SCRAPER_HEADLESS=true
IG_HIGHLIGHTS_ENABLED=true

# ── Concurrency / pacing ──────────────────────────────────────────────────────
IG_CONCURRENCY=4
IG_CIRCUIT_THRESHOLD=12

# ── Tier cadences (hours between fetches) ─────────────────────────────────────
IG_TIER_HOT_HOURS=12
IG_TIER_WARM_HOURS=24
IG_TIER_COLD_HOURS=96
IG_TIER_DORMANT_HOURS=336

# ── Ops ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── DeepSeek experience extraction (optional) ─────────────────────────────────
# OpenAI-compatible chat API. When DEEPSEEK_API_KEY is set, extraction uses it
# to refine experience names/schedules/prices after the heuristic gate.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Defaults to true when API key is set. Set false to force heuristics only.
DEEPSEEK_ENABLED=
DEEPSEEK_THINKING=false
DEEPSEEK_TIMEOUT_S=45
DEEPSEEK_MAX_PER_REQUEST=25
LLM_BACKFILL_LIMIT=25
WEB_MENU_BACKFILL_LIMIT=20
WEB_MENU_EVERY_DAYS=7

# ── Logged-in Instagram (handle discovery ONLY — not post ingest) ─────────────
# From a logged-in browser session on instagram.com (Application → Cookies).
# Required: IG_SESSIONID, IG_CSRFTOKEN. Optional: ds_user_id, mid, ig_did.
# Rotate immediately if these ever appear in chat/logs. Never commit.
# Netscape cookie jar path (browser export). Preferred over IG_SESSIONID alone.
IG_COOKIES_FILE=cookies.txt
# On Render: paste the entire Netscape cookie file into this secret (multiline).
IG_COOKIES_NETSCAPE=
# Or paste a raw Cookie header:
IG_COOKIES=
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=
IG_MID=
IG_DID=
IG_HANDLE_MIN_SCORE=0.55
IG_SEARCH_GAP_S=2.5

# ── Auto venue discovery (Places → IG handles → seed) ─────────────────────────
# auto = Google if key set, else free OpenStreetMap Overpass
PLACES_BACKEND=auto
GOOGLE_PLACES_API_KEY=
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
DISCOVER_CITY=lagos
DISCOVER_PLACE_LIMIT=150
DISCOVER_RESOLVE_LIMIT=40

# ── Scheduler cadence (local schedule CLI + Runs UI; match Render crons) ───────
INGEST_EVERY_MINUTES=30
INGEST_LIMIT=40
DISCOVER_EVERY_HOURS=4
DISCOVER_CRON_MINUTE=15

# ── API CORS (Vercel dashboard → Render API) ──────────────────────────────────
# Comma-separated exact origins for local/custom domains. *.vercel.app is
# allowed by default via IG_CORS_ORIGIN_REGEX in serve.py.
IG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# IG_CORS_ORIGIN_REGEX=https://([a-z0-9-]+\.)*vercel\.app
# KEEPALIVE_URL=https://ig-ingest-api.onrender.com/api/health
# Gemini. Used for vision only: venue photos to lighting/coziness/seating.
# Free tier is ~200 requests/day, which one 500-venue run exceeds.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_PHOTOS=8

# Serper. Google results without a Custom Search project. Used for Instagram
# handle lookup, venue facts (founding year, dress code, WhatsApp) and
# interior image search. 1 credit per query, 2500 free.
SERPER_API_KEY=
SERPER_COUNTRY=ng

# Reisty. Optional; just 69 Lagos venues, enabled with --with-reisty... so not really needed.
# REISTY_API_KEY=